{
  "name": "@berkayorhan/stackkit-core",
  "version": "0.1.0",
  "description": "Core project planning and lifecycle engine for Stackkit.",
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./customizer": {
      "types": "./dist/customizer.d.ts",
      "default": "./dist/customizer.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@berkayorhan/stackkit-schemas": "workspace:*",
    "@berkayorhan/stackkit-templates": "workspace:*"
  }
}
